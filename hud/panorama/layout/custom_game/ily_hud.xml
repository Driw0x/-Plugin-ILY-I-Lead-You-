<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/ily_hud.css" />
    </styles>
    <Panel class="ily-screen" hittest="false">
        <Panel id="ily_panel" class="ily-card" hittest="false">
            <Label class="ily-heading" text="ILY  /  PLAN D'ÉQUIPE" hittest="false" />
            <Label id="ily_economy" class="ily-economy" text="{s:value}" hittest="false" />
            <Panel class="ily-divider" hittest="false" />
            <Label id="ily_tactic" class="ily-tactic" text="{s:value}" hittest="false" />
            <Label id="ily_status" class="ily-status" text="{s:value}" hittest="false" />
            <Panel class="ily-options" hittest="false">
                <Label id="ily_option_1" class="ily-option" text="{s:value}" hittest="false" />
                <Label id="ily_option_2" class="ily-option" text="{s:value}" hittest="false" />
                <Label id="ily_option_3" class="ily-option" text="{s:value}" hittest="false" />
                <Label id="ily_option_4" class="ily-option" text="{s:value}" hittest="false" />
            </Panel>
            <Panel class="ily-positions" hittest="false">
                <Panel class="ily-position" hittest="false">
                    <Label id="ily_role_1" class="ily-role" text="{s:value}" hittest="false" />
                    <Label id="ily_detail_1" class="ily-detail" text="{s:value}" hittest="false" />
                </Panel>
                <Panel class="ily-position" hittest="false">
                    <Label id="ily_role_2" class="ily-role" text="{s:value}" hittest="false" />
                    <Label id="ily_detail_2" class="ily-detail" text="{s:value}" hittest="false" />
                </Panel>
                <Panel class="ily-position" hittest="false">
                    <Label id="ily_role_3" class="ily-role" text="{s:value}" hittest="false" />
                    <Label id="ily_detail_3" class="ily-detail" text="{s:value}" hittest="false" />
                </Panel>
            </Panel>
            <Label class="ily-help" text="Choix: !1, !2… dans le chat  ·  .info" hittest="false" />
        </Panel>
    </Panel>
</root>
